{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "callbridge-telephony",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "EXTERNAL_EFFECTS_ENABLED": "false",
    "OPENAI_REALTIME_MODEL": "gpt-realtime-2.1-mini",
    "OPENAI_SUMMARY_MODEL": "gpt-5.4-mini",
    "CALLBRIDGE_BLOCKED_CALL_COUNTRIES": "CU,IR,KP,SY",
    "CALLBRIDGE_MANUAL_REVIEW_COUNTRIES": "BY,RU",
    "CALLBRIDGE_GEO_PERMISSION_MODE": "just_in_time_low_risk",
    "CALLBRIDGE_MAX_PSTN_RATE_USD": "2.00",
    "CALLBRIDGE_MAX_PSTN_CALL_USD": "6.00",
    "DEMO_HOTEL_ENABLED": "false",
    "DEMO_HOTEL_DAILY_ATTEMPT_LIMIT": "20",
    "DEMO_HOTEL_MAX_CONNECTED_SECONDS": "180",
    "DEMO_HOTEL_MAX_DAILY_COST_MINOR_UNITS": "2000",
    "DEMO_HOTEL_MAX_RESERVED_COST_PER_CALL_MINOR_UNITS": "100",
    "DEMO_HOTEL_FACT_SHEET_REVISION": "aurora_demo_hotel_v1",
    "DEMO_HOTEL_NUMBER": "+18636228973",
    "DEMO_HOTEL_EXPECTED_FROM": "+16508897031",
    "CALLBACK_URL": "https://hardy-hedgehog-401.convex.site/webhooks/inquiry-worker"
  },
  "durable_objects": {
    "bindings": [
      { "name": "CALL_SESSIONS", "class_name": "CallSession" },
      { "name": "DEMO_HOTEL_RECIPIENT", "class_name": "DemoHotelRecipient" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CallSession"] },
    { "tag": "v2", "new_sqlite_classes": ["DemoHotelRecipient"] }
  ]
}
