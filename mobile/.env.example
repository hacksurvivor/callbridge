EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Native iPhone remote-control traffic uses Convex HTTP Actions.
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
# Keep false until a deployed Convex project and WorkOS-backed authenticated
# session have been verified. This is a second deliberate consent to mobile
# mutations; a URL alone never enables sync.
EXPO_PUBLIC_ENABLE_REMOTE_SYNC=false
