{
  "name": "callbridge-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "build:web": "npm --prefix web run build",
    "build:telephony": "npm --prefix telephony-worker run build",
    "test": "vitest run",
    "test:web": "npm --prefix web test",
    "test:telephony": "npm --prefix telephony-worker test",
    "test:watch": "vitest",
    "verify:submission": "node scripts/verify-submission.mjs"
  },
  "dependencies": {
    "convex": "1.43.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^24.10.0",
    "convex-test": "^0.0.56",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
