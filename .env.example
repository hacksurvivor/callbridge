# External effects remain disabled even when provider credentials are present.
CALLBRIDGE_EXTERNAL_EFFECTS_ENABLED=false
# Convex only schedules the provider dispatcher when this and the worker's
# external-effects flag are both true.
CALLBRIDGE_AUTOMATIC_DISPATCH_ENABLED=false

# Convex and WorkOS AuthKit
CONVEX_DEPLOYMENT=
WORKOS_CLIENT_ID=
WORKOS_API_KEY=

# macOS remote host. Use the Convex HTTP Actions URL ending in .convex.site.
# The agent workspace is the only directory writable by remote Codex tasks.
CALLBRIDGE_REMOTE_SITE_URL=https://your-deployment.convex.site
CALLBRIDGE_AGENT_WORKSPACE=/absolute/path/to/an/allowed/workspace
# Optional when the Codex CLI is not in a standard installation path.
CALLBRIDGE_CODEX_PATH=

# Billing webhook
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Realtime and telephony
OPENAI_API_KEY=
CALLBRIDGE_REALTIME_MODEL=gpt-realtime-2.1-mini
CALLBRIDGE_CONTACT_SEARCH_MODEL=gpt-5.4-mini
CALLBRIDGE_DRAFT_MODEL=gpt-5.4-mini
CALLBRIDGE_TELEPHONY_PROVIDER=
CALLBRIDGE_TELEPHONY_DISPATCH_URL=
# Optional explicit endpoint; otherwise derived by replacing the dispatch URL
# path with /pricing-quote.
CALLBRIDGE_TELEPHONY_PRICING_URL=
CALLBRIDGE_TELEPHONY_API_KEY=
CALLBRIDGE_TELEPHONY_WEBHOOK_SECRET=

# The user never configures Twilio. CallBridge quotes any provider-supported
# destination and enables its low-risk route just-in-time after confirmation.
CALLBRIDGE_BLOCKED_CALL_COUNTRIES=CU,IR,KP,SY
CALLBRIDGE_MANUAL_REVIEW_COUNTRIES=BY,RU
CALLBRIDGE_GEO_PERMISSION_MODE=just_in_time_low_risk
CALLBRIDGE_MAX_PSTN_RATE_USD=2.00
CALLBRIDGE_MAX_PSTN_CALL_USD=6.00
TWILIO_ACCOUNT_SID=
# Restricted key with only Voice Calls Create permission.
TWILIO_API_KEY=
TWILIO_API_KEY_SECRET=
# Isolated server-only Standard key for provider pricing and low-risk Voice
# Dialing Permissions. Twilio does not expose those resources to restricted
# keys. Never expose this credential to the browser or user.
TWILIO_CONTROL_API_KEY=
TWILIO_CONTROL_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
CALLBRIDGE_CALL_POLICY_VERSION=
CALLBRIDGE_TRANSCRIPTION_DISCLOSURE=required_before_conversation
CALLBRIDGE_TRANSCRIPT_RETENTION_DAYS=

# WebMCP hotel demo. Keep blank/false until the controlled recipient and legal
# reviewer approve the destination and exact truthful Japanese disclosure.
CALLBRIDGE_DEMO_RECIPIENT_APPROVED=false
CALLBRIDGE_DEMO_LEGAL_APPROVED=false
CALLBRIDGE_DEMO_DESTINATION_DISPLAY_NAME=
CALLBRIDGE_DEMO_DESTINATION_PHONE_E164=
CALLBRIDGE_DEMO_DESTINATION_MASKED_PHONE=
CALLBRIDGE_DEMO_DISCLOSURE_JA=
CALLBRIDGE_DEMO_DISCLOSURE_APPROVED_AT=

# Optional notification and connector capabilities
EXPO_ACCESS_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Base64url-encoded 32-byte AES key. Generate once and never expose to clients.
CALLBRIDGE_CONNECTOR_TOKEN_ENCRYPTION_KEY=
BOOKING_DEMAND_API_KEY=
BOOKING_AFFILIATE_ID=
# Defaults to sandbox. Set to production only after partner and release approval.
BOOKING_DEMAND_ENVIRONMENT=sandbox
