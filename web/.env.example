VITE_CONVEX_URL=
VITE_WORKOS_CLIENT_ID=
VITE_WORKOS_REDIRECT_URI=http://localhost:5173/callback

# Production candidate requirements:
# - provision a dedicated WorkOS Production application;
# - use the same client ID here and as WORKOS_CLIENT_ID in Convex;
# - allow exactly https://callbridge-web.pages.dev/callback in that application;
# - never commit WorkOS API keys, judge credentials, sessions, or cookies.
# VITE_WORKOS_REDIRECT_URI=https://callbridge-web.pages.dev/callback

# Development-only. Production builds ignore local simulation data.
VITE_CALLBRIDGE_SIMULATION=false
