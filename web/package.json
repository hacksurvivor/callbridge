{
  "name": "callbridge-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:production": "tsc -b && node scripts/build-production.mjs",
    "deploy": "node scripts/verify-deploy-source.mjs && npm run build:production && ../telephony-worker/node_modules/.bin/wrangler pages deploy dist --project-name callbridge-web --branch main",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.17",
    "@convex-dev/workos": "0.0.3",
    "@workos-inc/authkit-react": "0.16.2",
    "assistant-stream": "0.3.40",
    "convex": "1.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.10"
  }
}
