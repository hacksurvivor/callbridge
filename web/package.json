{
  "name": "callbridge-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:production": "tsc -b && node scripts/build-production.mjs",
    "deploy": "node scripts/verify-deploy-source.mjs && npm run build:production && ../telephony-worker/node_modules/.bin/wrangler pages deploy dist --project-name callbridge-web --branch main",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.17",
    "@assistant-ui/react-markdown": "^0.14.13",
    "@convex-dev/workos": "0.0.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@workos-inc/authkit-react": "0.16.2",
    "assistant-stream": "0.3.40",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "1.43.0",
    "lucide-react": "^1.40.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.12",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "shadcn": "^4.20.1",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.10"
  }
}
